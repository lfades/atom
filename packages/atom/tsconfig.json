{
	"compilerOptions": {
		"target": "ES2022",
		"module": "Node16",
		"rootDir": "./src",
		"outDir": "dist",
		"lib": ["DOM", "ES2023"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": true,
		"forceConsistentCasingInFileNames": true,
		"declaration": true,
		"incremental": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"preserveSymlinks": true,
		"jsx": "react-jsx"
	},
	"include": ["src/**/*.ts", "src/**/*.tsx"],
	"exclude": ["node_modules"]
}
