{
	"$schema": "https://turborepo.org/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": [".next/**", "!.next/cache/**", "./dist/**"]
		},
		"format": {
			"outputs": []
		},
		"lint": {
			"outputs": []
		},
		"check": {
			"outputs": []
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"start": {
			"cache": false,
			"persistent": true
		},
		"clean": {
			"cache": false
		}
	}
}
